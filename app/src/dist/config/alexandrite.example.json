{
  "app": {
    "zone": null,
    "language": "en",
    "shutdownGraceSeconds": 15,
    "startTimeoutSeconds": 30,
    "plugins": [],
    "updates": {"check": true, "install": false, "idleMinutes": 120}
  },
  "mcp": {
    "servers": {
      "git": {
        "command": "uvx",
        "args": ["mcp-server-git", "--repository", "/srv/projects/app"],
        "env": {},
        "tools": {"allow": ["*"], "deny": ["git_reset"]},
        "risk": {"git_status": "read_only", "git_diff*": "read_only", "git_log": "read_only", "git_show": "read_only", "git_branch": "read_only", "*": "workspace_write"},
        "trustAnnotations": false,
        "trusted": false,
        "timeoutSeconds": 60,
        "enabled": false
      },
      "docs": {
        "url": "https://mcp.example.com/mcp",
        "oauth": {"scopes": ["read"]},
        "tools": {"allow": ["search_*", "fetch_*"]},
        "risk": {"*": "network_read"},
        "timeoutSeconds": 30,
        "enabled": false
      }
    }
  },
  "channels": {
    "onebot": {
      "enabled": false,
      "settings": {
        "eventQueueCapacity": 1024
      },
      "instances": {
        "main": {
          "transport": "ws_reverse",
          "listenHost": "127.0.0.1",
          "listenPort": 8080,
          "allowedChats": [],
          "admins": [],
          "approvalMinutes": 10
        }
      }
    },
    "qqbot": {
      "enabled": false,
      "instances": {
        "main": {
          "appId": "10000",
          "appSecret": "replace-with-the-app-secret",
          "apiBase": "https://api.bot.qq.com",
          "intents": 33554432,
          "streaming": true,
          "approvalMinutes": 10,
          "admins": []
        }
      }
    }
  }
}
